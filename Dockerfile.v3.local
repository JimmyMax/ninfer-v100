# Dockerfile.v3.local — 离线构建版（基于老仓库 Dockerfile.v100.local 改造）
# build 阶段用本地 nvidia/cuda:12.8.0-cudnn-devel-ubuntu24.04
# CUTLASS 复用老仓库 third_party/cutlass（v4.4.2）
# runtime 阶段用本地 ninfer:v100-stable 作基底

FROM nvidia/cuda:12.8.0-cudnn-devel-ubuntu24.04 AS build

ARG DEBIAN_FRONTEND=noninteractive
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG http_proxy=${HTTP_PROXY}
ARG https_proxy=${HTTPS_PROXY}

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        ca-certificates \
        cmake \
        git \
        libavcodec-dev \
        libavformat-dev \
        libavutil-dev \
        libcurl4-openssl-dev \
        libswscale-dev \
        ninja-build \
        pkg-config \
        python3 \
    && rm -rf /var/lib/apt/lists/*

RUN if [ -n "$HTTPS_PROXY" ]; then \
        git config --global http.proxy "$HTTPS_PROXY"; \
        git config --global https.proxy "$HTTPS_PROXY"; \
    fi

WORKDIR /src
COPY . .

ARG CUTLASS_DIR
RUN CUTLASS_OPT=""; \
    if [ -n "$CUTLASS_DIR" ]; then \
        echo "Using local CUTLASS source: $CUTLASS_DIR"; \
        CUTLASS_OPT="-DFETCHCONTENT_SOURCE_DIR_CUTLASS=$CUTLASS_DIR"; \
    fi \
    && cmake -S . -B /build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_CUDA_ARCHITECTURES=70 \
        -DNINFER_BUILD_APPS=ON \
        -DBUILD_TESTING=OFF \
        -DNINFER_BUILD_BENCHMARKS=OFF \
        $CUTLASS_OPT \
    && cmake --build /build --parallel --target ninfer ninfer-serve

FROM ninfer:v100-stable
COPY --from=build /build/apps/ninfer /usr/local/bin/ninfer
COPY --from=build /build/apps/ninfer-serve /usr/local/bin/ninfer-serve
WORKDIR /workspace
EXPOSE 8080
STOPSIGNAL SIGTERM
CMD ["ninfer-serve", "--help"]
