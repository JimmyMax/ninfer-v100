# Dockerfile.1.8.0-inkling2.local — 在 1.7.2 基础上加入 inkling2 支持（inkling2 分支构建）
#
#   构建（sm_70）: 容器 ninfer-build-inkling2 里 make -j36，产物 /build/apps/ninfer-serve
#   docker build -f Dockerfile.1.8.0-inkling2.local -t ninfer:1.8.0-inkling2 .
#
# 保留 1.7.2 的 sm89 二进制与默认 ninfer-serve，只替换 sm70。
FROM ninfer:1.7.2

COPY docker-runtime/1.8.0-inkling2/ninfer-serve.sm70 /opt/ninfer/ninfer-serve.sm70
RUN chmod +x /opt/ninfer/ninfer-serve.sm70

WORKDIR /workspace
EXPOSE 8000
CMD ["ninfer-serve", "--help"]
